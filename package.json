{
  "name": "finex.io",
  "version": "1.11.0",
  "private": true,
  "description": "finex.io",
  "author": "Maksim Amelchenko <m.amelchenko@gmail.com>",
  "keywords": [
    "Budget Tracker & Planner",
    "Online Money Management",
    "FINEX.io"
  ],
  "scripts": {
    "develop": "gatsby develop --host=0.0.0.0",
    "start": "gatsby develop",
    "build": "gatsby build && [ $GIT_TAG ] && version=$GIT_TAG:$GIT_HASH || version=$npm_package_version:$GIT_HASH && printf $version > ./public/version",
    "serve": "gatsby serve",
    "clean": "gatsby clean",
    "generate-translations": "ts-node -P i18n/tsconfig.json i18n/scanForI18N.ts && prettier --write './locales/*.ts'",
    "storybook": "start-storybook -p 6006",
    "build-storybook": "build-storybook",
    "prepare": "husky install"
  },
  "browserslist": [
    ">1%",
    "last 2 versions"
  ],
  "dependencies": {
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "deepmerge": "^4.3.1",
    "gatsby": "^5.13.7",
    "gatsby-plugin-image": "^3.13.1",
    "gatsby-plugin-manifest": "^5.13.1",
    "gatsby-plugin-react-helmet": "^6.13.1",
    "gatsby-plugin-sass": "^6.13.1",
    "gatsby-plugin-sharp": "^5.13.1",
    "gatsby-plugin-sitemap": "^6.13.1",
    "gatsby-plugin-svgr": "^3.0.0-beta.0",
    "gatsby-source-filesystem": "^5.13.1",
    "gatsby-theme-i18n": "^3.0.0",
    "gatsby-transformer-sharp": "^5.13.1",
    "i18n-js": "^3.9.2",
    "lodash.get": "^4.4.2",
    "normalize.css": "^8.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet": "^6.1.0",
    "sass": "^1.80.3"
  },
  "devDependencies": {
    "@babel/core": "^7.25.8",
    "@storybook/addon-actions": "^6.5.13",
    "@storybook/addon-essentials": "^6.5.13",
    "@storybook/addon-links": "^6.5.13",
    "@storybook/builder-webpack5": "^6.5.13",
    "@storybook/manager-webpack5": "^6.5.13",
    "@storybook/react": "^6.5.13",
    "@svgr/webpack": "^8.1.0",
    "@types/react": "^18.3.11",
    "ajv": "^8.17.1",
    "babel-loader": "^9.1.0",
    "eslint": "^7.32.0",
    "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-prettier": "^4.2.1",
    "husky": "^7.0.0",
    "inter-ui": "^3.19.3",
    "lint-staged": "^15.2.10",
    "postcss": "^8.4.47",
    "prettier": "^3.3.3",
    "ts-node": "^10.9.1",
    "typescript": "^5.6.3"
  },
  "lint-staged": {
    "*.js": "eslint --cache --fix"
  }
}
